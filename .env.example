GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
YOUTUBE_API_KEY=
# Optional: direct publishing uses a Google OAuth Desktop app client.
# Alternatively import its downloaded JSON in Settings > YouTube publishing.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Change only when your local engine uses a different port.
# SHORTFORGE_YOUTUBE_REDIRECT_URI=http://127.0.0.1:8787/api/youtube/oauth/callback
# Optional executable/model locations. No model downloads happen automatically.
FFMPEG_PATH=
PIPER_MODEL=
WHISPER_MODEL=base
# Optional: use an existing Concat desktop installation instead of the portable runtime.
CONCAT_PATH=
