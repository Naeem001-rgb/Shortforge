{
  "manifest_version": 3,
  "name": "ShortForge Scout",
  "version": "0.1.2",
  "description": "Discover promising YouTube Shorts and send them to your local ShortForge library.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1:8787/*", "http://localhost:8787/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "ShortForge Scout" },
  "content_scripts": [{ "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
